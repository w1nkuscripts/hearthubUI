	local function scrollBy(scroller, delta)
		local maxX = math.max(0, scroller.AbsoluteCanvasSize.X - scroller.AbsoluteWindowSize.X)
		scroller.CanvasPosition = Vector2.new(math.clamp(scroller.CanvasPosition.X + delta, 0, maxX), 0)
	end
	local function bindWheel(scroller, obj)
		obj.MouseWheelForward:Connect(function()
			scrollBy(scroller, -50)
		end)
		obj.MouseWheelBackward:Connect(function()
			scrollBy(scroller, 50)
		end)
	end
	bindWheel(tabsScroll, tabsScroll)
	bindWheel(tabsScroll, tabsHolder)

	local function reveal(scroller, holder, btn)
		task.defer(function()
			if not btn.Parent then
				return
			end
			local left = btn.AbsolutePosition.X - holder.AbsolutePosition.X
			local right = left + btn.AbsoluteSize.X
			local cx = scroller.CanvasPosition.X
			local view = scroller.AbsoluteWindowSize.X
			if left < cx then
				cx = left - 6
			elseif right > cx + view then
				cx = right - view + 6
			end
			scroller.CanvasPosition = Vector2.new(math.max(cx, 0), 0)
		end)
	end

