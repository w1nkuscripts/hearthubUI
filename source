					b.BackgroundTransparency = 0
					b.BackgroundColor3 = T.Element
				end)
				b.MouseLeave:Connect(function()
					b.BackgroundTransparency = 1
				end)
				b.MouseButton1Click:Connect(function()
					closeSearch()
					Window:Navigate(e)
				end)
				table.insert(resultRows, b)
			end
		end
		if shown == 0 then
			local msg = newText("TextLabel", {
				Text = q == "" and "type to search functions" or "nothing found",
				TextColor3 = T.TextOff,
				Size = UDim2.new(1, 0, 0, 22),
