local Section = {}
Section.__index = Section

function Section:_order()
	self.Order += 1
	return self.Order
end

function Section:AddLabel(txt)
	local L = {}
	local lbl = newText("TextLabel", {
		Text = txt,
		TextColor3 = T.TextDim,
		Size = UDim2.new(1, 0, 0, 14),
		LayoutOrder = self:_order(),
	}, self.Box)
	function L:SetText(s)
		lbl.Text = s
	end
	return L
end

function Section:AddButton(name, callback)
	local B = { Type = "Button", Name = name }
	local row = frame({ Size = UDim2.new(1, 0, 0, 20), LayoutOrder = self:_order() }, self.Box)
	local btn = newText("TextButton", {
		Text = name,
		BackgroundTransparency = 0,
		BackgroundColor3 = T.Element,
		TextXAlignment = Enum.TextXAlignment.Center,
		Size = UDim2.fromScale(1, 1),
	}, row)
	stroke(btn, T.Border)
	btn.MouseEnter:Connect(function()
		tween(btn, 0.12, { BackgroundColor3 = Color3.fromRGB(37, 37, 43) })
	end)
	btn.MouseLeave:Connect(function()
		tween(btn, 0.12, { BackgroundColor3 = T.Element })
	end)
	btn.MouseButton1Click:Connect(function()
		btn.TextColor3 = T.Accent
		tween(btn, 0.25, { TextColor3 = T.Text })
		fire(callback)
	end)
	Library:Register(name, self.Sub, row)
	return B
end

function Section:AddToggle(name, opts)
	opts = opts or {}
	local Tg = {
		Type = "Toggle",
		Name = name,
		Flag = opts.Flag,
		Value = false,
		Key = nil,
		Mode = opts.Mode or "hold",
		KeyDown = false,
		HasBind = opts.Keybind == true,
		Callback = opts.Callback,
	}
	local row = frame({ Size = UDim2.new(1, 0, 0, 16), LayoutOrder = self:_order() }, self.Box)
	local box = frame({
		BackgroundColor3 = T.Element,
		Size = UDim2.fromOffset(10, 10),
		Position = UDim2.new(0, 0, 0.5, -5),
	}, row)
	stroke(box, T.Border)
	local fill = frame({
		BackgroundColor3 = T.Accent,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(0, 0),
	}, box)
	local lbl = newText("TextLabel", {
		Text = name,
		TextColor3 = T.TextDim,
		Size = UDim2.new(1, -40, 1, 0),
		Position = UDim2.fromOffset(18, 0),
	}, row)
	local hit = create("TextButton", {
		BackgroundTransparency = 1,
		Text = "",
		Size = UDim2.new(1, -24, 1, 0),
	}, row)

	local paintGear = function() end

	function Tg:Set(v, silent)
		self.Value = v and true or false
		if self.Value then
			tween(fill, 0.18, { Size = UDim2.fromOffset(6, 6) }, Enum.EasingStyle.Back)
		else
			tween(fill, 0.12, { Size = UDim2.fromOffset(0, 0) })
		end
		tween(lbl, 0.12, { TextColor3 = self.Value and T.Text or T.TextDim })
		commitFlag(self, self.Value)
		if not silent then
			fire(self.Callback, self.Value)
		end
		Library:RefreshKeybindList()
	end

	hit.MouseButton1Click:Connect(function()
		Tg:Set(not Tg.Value)
	end)
	hit.MouseEnter:Connect(function()
		if not Tg.Value then
			tween(lbl, 0.1, { TextColor3 = T.Text })
		end
	end)
	hit.MouseLeave:Connect(function()
		tween(lbl, 0.1, { TextColor3 = Tg.Value and T.Text or T.TextDim })
	end)

	if Tg.HasBind then
		table.insert(Library.Binds, Tg)

		local gearBtn = create("TextButton", {
			BackgroundTransparency = 1,
			Text = "",
			Size = UDim2.fromOffset(18, 16),
			Position = UDim2.new(1, -18, 0.5, -8),
		}, row)
		local gearHolder, setGearColor = makeGear(gearBtn, T.TextOff)

		local function gearBase()
			return (Tg.Key ~= nil or Tg.Mode == "always") and T.Accent or T.TextOff
		end
		paintGear = function()
			setGearColor(gearBase(), true)
		end

		gearBtn.MouseEnter:Connect(function()
			tween(gearHolder, 0.35, { Rotation = 45 })
			setGearColor(T.Text, true)
		end)
		gearBtn.MouseLeave:Connect(function()
			tween(gearHolder, 0.35, { Rotation = 0 })
			setGearColor(gearBase(), true)
		end)

		-- 
		local pop = frame({
			BackgroundColor3 = T.Background,
			Size = UDim2.fromOffset(130, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			Visible = false,
			ZIndex = 2,
		}, Library.Overlay)
		stroke(pop, T.Border)
		padding(pop, 4, 4, 4, 4)
		list(pop, 2)

		local keyBtn = newText("TextButton", {
			Text = "",
			BackgroundTransparency = 0,
			BackgroundColor3 = T.Element,
			Size = UDim2.new(1, 0, 0, 18),
			LayoutOrder = 1,
			ZIndex = 2,
		}, pop)
		padding(keyBtn, 6, 0, 0, 0)
		stroke(keyBtn, T.Border)

		local modeBtns = {}
		local function refreshPopup()
			if Library.Listening and Library.Popup and Library.Popup.Frame == pop then
				keyBtn.Text = "key: ..."
				keyBtn.TextColor3 = T.Accent
			else
				keyBtn.Text = "key: " .. keyName(Tg.Key)
				keyBtn.TextColor3 = T.Text
			end
			for m, b in pairs(modeBtns) do
				tween(b, 0.12, { TextColor3 = (Tg.Mode == m) and T.Accent or T.TextDim })
			end
			paintGear()
		end

		for i, m in ipairs({ "toggle", "hold", "always" }) do
			local b = newText("TextButton", {
				Text = m,
				Size = UDim2.new(1, 0, 0, 16),
				LayoutOrder = i + 1,
				TextColor3 = T.TextDim,
				ZIndex = 2,
			}, pop)
			padding(b, 6, 0, 0, 0)
			modeBtns[m] = b
			b.MouseButton1Click:Connect(function()
				Tg:SetMode(m)
			end)
		end

		function Tg:SetKey(k)
			self.Key = k
			self.KeyDown = false
			refreshPopup()
			Library:RefreshKeybindList()
		end

		function Tg:SetMode(m)
			local old = self.Mode
			self.Mode = m
			self.KeyDown = false
			if m == "always" then
				self:Set(true)
			elseif old == "always" then
				self:Set(false)
			end
			refreshPopup()
			Library:RefreshKeybindList()
		end

		keyBtn.MouseButton1Click:Connect(function()
			Library.Listening = function(input)
				if input.UserInputType == Enum.UserInputType.Keyboard then
					if input.KeyCode == Enum.KeyCode.Escape or input.KeyCode == Enum.KeyCode.Backspace then
						Tg:SetKey(nil)
					else
						Tg:SetKey(input.KeyCode)
					end
				elseif input.UserInputType == Enum.UserInputType.MouseButton2
					or input.UserInputType == Enum.UserInputType.MouseButton3 then
					Tg:SetKey(input.UserInputType)
				end
				Library.Listening = nil
				refreshPopup()
			end
			refreshPopup()
		end)

		gearBtn.MouseButton1Click:Connect(function()
			Library:OpenPopup(pop, gearBtn, function()
				local a, o = gearBtn.AbsolutePosition, Library.Overlay.AbsolutePosition
				local vp = Library.Overlay.AbsoluteSize
				pop.Position = UDim2.fromOffset(math.clamp(a.X - o.X + 18 - 130, 4, vp.X - 134), a.Y - o.Y + 20)
			end, refreshPopup)
			refreshPopup()
		end)

		refreshPopup()
	end

	Tg:Set(opts.Default == true, false)
	if Tg.Flag then
		Library.Options[Tg.Flag] = Tg
	end
	Library:Register(name, self.Sub, row)
	return Tg
end

function Section:AddSlider(name, opts)
	opts = opts or {}
	local S = {
		Type = "Slider",
		Name = name,
		Flag = opts.Flag,
		Min = opts.Min or 0,
		Max = opts.Max or 100,
		Rounding = opts.Rounding or 0,
		Suffix = opts.Suffix or "",
		Callback = opts.Callback,
		Value = 0,
	}
	local row = frame({ Size = UDim2.new(1, 0, 0, 30), LayoutOrder = self:_order() }, self.Box)
	newText("TextLabel", { Text = name, Size = UDim2.new(0.65, 0, 0, 14) }, row)
	local valLbl = newText("TextLabel", {
		Text = "",
		Size = UDim2.new(0.35, 0, 0, 14),
		Position = UDim2.fromScale(0.65, 0),
		TextXAlignment = Enum.TextXAlignment.Right,
	}, row)
	local bar = frame({
		BackgroundColor3 = T.Element,
		Size = UDim2.new(1, 0, 0, 8),
		Position = UDim2.fromOffset(0, 19),
	}, row)
	stroke(bar, T.Border)
	local fillBar = frame({ BackgroundColor3 = T.Accent, Size = UDim2.fromScale(0, 1) }, bar)
	local hit = create("TextButton", {
		BackgroundTransparency = 1,
		Text = "",
		Size = UDim2.new(1, 0, 0, 16),
		Position = UDim2.fromOffset(0, 15),
	}, row)

	function S:Set(v, silent)
		local step = 10 ^ -self.Rounding
		v = math.clamp(math.floor(v / step + 0.5) * step, self.Min, self.Max)
		v = tonumber(string.format("%." .. self.Rounding .. "f", v))
		self.Value = v
		local a = (v - self.Min) / math.max(self.Max - self.Min, 1e-9)
		fillBar.Size = UDim2.fromScale(a, 1)
		valLbl.Text = string.format("%." .. self.Rounding .. "f", v) .. self.Suffix
		commitFlag(self, v)
		if not silent then
			fire(self.Callback, v)
		end
	end

	hit.InputBegan:Connect(function(input)
		if isPress(input) then
			local function upd()
				local a = math.clamp((cursor().X - bar.AbsolutePosition.X) / math.max(bar.AbsoluteSize.X, 1), 0, 1)
				S:Set(S.Min + a * (S.Max - S.Min))
			end
			Library.Dragging = { Update = upd }
			upd()
		end
	end)

	S:Set(opts.Default or S.Min, false)
	if S.Flag then
		Library.Options[S.Flag] = S
	end
	Library:Register(name, self.Sub, row)
	return S
end

function Section:AddDropdown(name, opts)
	opts = opts or {}
	local D = {
		Type = "Dropdown",
		Name = name,
		Flag = opts.Flag,
		Multi = opts.Multi == true,
		Options = opts.Options or {},
		Callback = opts.Callback,
		Value = nil,
	}
	local row = frame({ Size = UDim2.new(1, 0, 0, 36), LayoutOrder = self:_order() }, self.Box)
	newText("TextLabel", { Text = name, Size = UDim2.new(1, 0, 0, 14) }, row)
	local box = newText("TextButton", {
		Text = "",
		BackgroundTransparency = 0,
		BackgroundColor3 = T.Element,
		Size = UDim2.new(1, 0, 0, 18),
		Position = UDim2.fromOffset(0, 17),
	}, row)
	stroke(box, T.Border)
	local valLbl = newText("TextLabel", {
		Text = "",
		Size = UDim2.new(1, -22, 1, 0),
		Position = UDim2.fromOffset(6, 0),
		TextColor3 = T.TextDim,
		TextTruncate = Enum.TextTruncate.AtEnd,
	}, box)
	local arrow = newText("TextLabel", {
		Text = "v",
		Size = UDim2.fromOffset(14, 18),
		Position = UDim2.new(1, -16, 0, 0),
		TextXAlignment = Enum.TextXAlignment.Center,
		TextColor3 = T.TextDim,
	}, box)

	local rows = math.min(#D.Options, 8)
	local fullH = rows * 18
	local pop = create("ScrollingFrame", {
		BackgroundColor3 = T.Background,
		BorderSizePixel = 0,
		Visible = false,
		ScrollBarThickness = 2,
		ScrollBarImageColor3 = T.Accent,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		Size = UDim2.fromOffset(100, 0),
		ZIndex = 2,
	}, Library.Overlay)
	stroke(pop, T.Border)
	list(pop, 0)

	local items = {}

	local function selectedList()
		if not D.Multi then
			return { D.Value }
		end
		local out = {}
		for _, o in ipairs(D.Options) do
			if D.Value[o] then
				table.insert(out, o)
			end
		end
		return out
	end

	local function refresh()
		local sel = selectedList()
		if D.Multi then
			valLbl.Text = #sel > 0 and table.concat(sel, ", ") or "none"
		else
			valLbl.Text = tostring(D.Value)
		end
		valLbl.TextColor3 = T.Text
		for o, b in pairs(items) do
			local on = D.Multi and D.Value[o] or (not D.Multi and D.Value == o)
			tween(b, 0.12, { TextColor3 = on and T.Accent or T.TextDim })
		end
	end

	function D:Get()
		if self.Multi then
			return selectedList()
		end
		return self.Value
	end

	function D:Set(v, silent)
		if self.Multi then
			self.Value = {}
			for _, n in ipairs(v or {}) do
				self.Value[n] = true
			end
		else
			self.Value = v
		end
		refresh()
		commitFlag(self, self:Get())
		if not silent then
			fire(self.Callback, self:Get())
		end
	end

	for i, o in ipairs(D.Options) do
		local b = newText("TextButton", {
			Text = o,
			Size = UDim2.new(1, 0, 0, 18),
			LayoutOrder = i,
			TextColor3 = T.TextDim,
			ZIndex = 2,
		}, pop)
		padding(b, 6, 0, 0, 0)
		items[o] = b
		b.MouseEnter:Connect(function()
			b.BackgroundTransparency = 0
			b.BackgroundColor3 = T.Element
		end)
		b.MouseLeave:Connect(function()
			b.BackgroundTransparency = 1
		end)
		b.MouseButton1Click:Connect(function()
			if D.Multi then
				local cur = {}
				for _, k in ipairs(D.Options) do
					local on = D.Value[k]
					if k == o then
						on = not on
					end
					if on then
						table.insert(cur, k)
					end
				end
				D:Set(cur)
			else
				D:Set(o)
				Library:ClosePopup()
			end
		end)
	end

	box.MouseButton1Click:Connect(function()
		local w = box.AbsoluteSize.X
		pop.Size = UDim2.fromOffset(w, 0)
		Library:OpenPopup(pop, box, function()
			-- 
			local a, o = box.AbsolutePosition, Library.Overlay.AbsolutePosition
			pop.Position = UDim2.fromOffset(a.X - o.X, a.Y - o.Y + box.AbsoluteSize.Y + 2)
			pop.Size = UDim2.fromOffset(box.AbsoluteSize.X, pop.Size.Y.Offset)
		end, function()
			tween(arrow, 0.15, { Rotation = 0, TextColor3 = T.TextDim })
		end)
		tween(pop, 0.18, { Size = UDim2.fromOffset(w, fullH) })
		tween(arrow, 0.15, { Rotation = 180, TextColor3 = T.Accent })
	end)

	local def = opts.Default
	if D.Multi then
		D:Set(type(def) == "table" and def or {}, true)
	else
		D:Set(def or D.Options[1], true)
	end
	if D.Flag then
		Library.Options[D.Flag] = D
	end
	Library:Register(name, self.Sub, row)
	return D
end

