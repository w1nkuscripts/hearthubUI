--// Helpers
local function connect(signal, fn)
	local c = signal:Connect(fn)
	table.insert(Library.Connections, c)
	return c
end

local function fire(cb, ...)
	if cb then
		local ok, err = pcall(cb, ...)
		if not ok then
			warn("[heart ui] callback error: " .. tostring(err))
		end
	end
end

local function create(class, props, parent)
	local o = Instance.new(class)
	for k, v in pairs(props) do
		o[k] = v
	end
	o.Parent = parent
	return o
end

local function frame(props, parent)
	props.BorderSizePixel = 0
	if props.BackgroundColor3 == nil and props.BackgroundTransparency == nil then
		props.BackgroundTransparency = 1
	end
	return create("Frame", props, parent)
end

local function newText(class, props, parent)
	props.BackgroundTransparency = 1
	props.BorderSizePixel = 0
	props.Font = props.Font or Library.Font
	props.TextSize = props.TextSize or Library.TextSize
	props.TextColor3 = props.TextColor3 or T.Text
	props.TextXAlignment = props.TextXAlignment or Enum.TextXAlignment.Left
	if class == "TextButton" then
		props.AutoButtonColor = false
	end
	return create(class, props, parent)
end

local function stroke(parent, color)
	return create("UIStroke", {
		Color = color or T.Border,
		Thickness = 1,
		LineJoinMode = Enum.LineJoinMode.Miter,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	}, parent)
end

local function padding(parent, l, t, r, b)
	return create("UIPadding", {
		PaddingLeft = UDim.new(0, l or 0),
		PaddingTop = UDim.new(0, t or 0),
		PaddingRight = UDim.new(0, r or 0),
		PaddingBottom = UDim.new(0, b or 0),
	}, parent)
end

local function list(parent, pad, horizontal)
	return create("UIListLayout", {
		Padding = UDim.new(0, pad or 0),
		SortOrder = Enum.SortOrder.LayoutOrder,
		FillDirection = horizontal and Enum.FillDirection.Horizontal or Enum.FillDirection.Vertical,
		VerticalAlignment = horizontal and Enum.VerticalAlignment.Center or Enum.VerticalAlignment.Top,
	}, parent)
end

local function tween(obj, time, props, style, dir)
	local tw = TweenService:Create(obj, TweenInfo.new(time, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), props)
	tw:Play()
	return tw
end

local function cursor()
	return UIS:GetMouseLocation()
end

local function isPress(input)
	return input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch
end

local function getGuiParent()
	local ok, ui = pcall(function()
		return gethui and gethui()
	end)
	if ok and ui then
		return ui
	end
	return LocalPlayer:WaitForChild("PlayerGui")
end

local function keyName(k)
	if not k then
		return "none"
	end
	if k.EnumType == Enum.UserInputType then
		return (k.Name:gsub("MouseButton", "MB"))
	end
	local n = k.Name:gsub("^Left(%u)", "L%1"):gsub("^Right(%u)", "R%1"):gsub("Control", "Ctrl")
	return n:upper()
end

-- 
local function resolvePos(obj)
	local p = obj.Parent.AbsoluteSize
	return Vector2.new(
		obj.Position.X.Scale * p.X + obj.Position.X.Offset,
		obj.Position.Y.Scale * p.Y + obj.Position.Y.Offset
	)
end

-- shimmer
local shimmers = {}

local function buildShimmer()
	return ColorSequence.new({
		ColorSequenceKeypoint.new(0, T.AccentDark),
		ColorSequenceKeypoint.new(0.35, T.AccentDark),
		ColorSequenceKeypoint.new(0.5, T.Accent:Lerp(Color3.new(1, 1, 1), 0.55)),
		ColorSequenceKeypoint.new(0.65, T.AccentDark),
		ColorSequenceKeypoint.new(1, T.AccentDark),
	})
end

local function shimmerLine(props, parent)
	props.BackgroundColor3 = Color3.new(1, 1, 1)
	local line = frame(props, parent)
	local g = create("UIGradient", { Color = SHIMMER }, line)
	table.insert(shimmers, g)
	return line
end

-- anim
local Lines = {}

local function makeLine(scroller, holder, padX)
	local L = {
		Frame = shimmerLine({ Size = UDim2.fromOffset(0, 2), ZIndex = 3, Visible = false }, scroller),
		Scroller = scroller,
		Holder = holder,
		PadX = padX,
		Target = nil,
		X = 0,
		W = 0,
		Init = false,
	}
	table.insert(Lines, L)
	return L
end

-- icons
local function makeGear(parent, color)
	local holder = frame({
		Size = UDim2.fromOffset(13, 13),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
	}, parent)
	local parts = {}
	for _, rot in ipairs({ 0, 45, 90, 135 }) do
		table.insert(parts, frame({
			BackgroundColor3 = color,
			Size = UDim2.fromOffset(13, 3),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Rotation = rot,
		}, holder))
	end
	local body = frame({
		BackgroundColor3 = color,
		Size = UDim2.fromOffset(9, 9),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
	}, holder)
	create("UICorner", { CornerRadius = UDim.new(1, 0) }, body)
	table.insert(parts, body)
	local hole = frame({
		BackgroundColor3 = T.Panel,
		Size = UDim2.fromOffset(5, 5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
	}, holder)
	create("UICorner", { CornerRadius = UDim.new(1, 0) }, hole)

	return holder, function(c, animated)
		for _, p in ipairs(parts) do
			if animated then
				tween(p, 0.15, { BackgroundColor3 = c })
			else
				p.BackgroundColor3 = c
			end
		end
	end
end

local function makeMagnifier(parent)
	local holder = frame({
		Size = UDim2.fromOffset(12, 12),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
	}, parent)
	local circle = frame({ Size = UDim2.fromOffset(8, 8) }, holder)
	create("UICorner", { CornerRadius = UDim.new(1, 0) }, circle)
	local st = stroke(circle, T.TextDim)
	local handle = frame({
		BackgroundColor3 = T.TextDim,
		Size = UDim2.fromOffset(5, 2),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromOffset(9.5, 9.5),
		Rotation = 45,
	}, holder)
	return function(color)
		tween(st, 0.15, { Color = color })
		tween(handle, 0.15, { BackgroundColor3 = color })
	end
end

-- CanvasGroup
local function fadeIn(g, slide)
	g:SetAttribute("Shown", true)
	g.Visible = true
	g.GroupTransparency = 1
	g.Position = UDim2.fromOffset(0, slide or 8)
	tween(g, 0.24, { GroupTransparency = 0, Position = UDim2.new() })
end

local function fadeOut(g)
	if not g.Visible then
		return
	end
	g:SetAttribute("Shown", false)
	tween(g, 0.12, { GroupTransparency = 1 })
	task.delay(0.14, function()
		if g.Parent and g:GetAttribute("Shown") == false then
			g.Visible = false
		end
	end)
end

-- Popups
function Library:OpenPopup(popupFrame, anchor, place, onClose)
	self:ClosePopup()
	self.Popup = { Frame = popupFrame, Anchor = anchor, Place = place, OnClose = onClose }
	self.Blocker.Visible = true
	popupFrame.Visible = true
	place()
end

function Library:ClosePopup()
	local p = self.Popup
	self.Popup = nil
	self.Listening = nil
	if self.Blocker then
		self.Blocker.Visible = false
	end
	if p then
		p.Frame.Visible = false
		if p.OnClose then
			p.OnClose()
		end
	end
end

-- Keybind list
function Library:RefreshKeybindList()
	if not self.KbInner then
		return
	end
	for i, t in ipairs(self.Binds) do
		local show = t.Value and (t.Mode == "always" or (t.Key ~= nil and (t.Mode ~= "hold" or t.KeyDown)))
		local e = self.KbEntries[t]
		local suffix = t.Mode == "hold" and "held" or (t.Mode == "toggle" and "toggled" or "always")
		local txt = string.format("%s (%s)", t.Name:lower(), suffix)

		if show then
			if not e then
				local holder = frame({
					Size = UDim2.fromOffset(0, 0),
					AutomaticSize = Enum.AutomaticSize.X,
					ClipsDescendants = true,
					LayoutOrder = i + 1,
					ZIndex = 3,
				}, self.KbInner)
				local lab = newText("TextLabel", {
					Text = txt,
					AutomaticSize = Enum.AutomaticSize.XY,
					Size = UDim2.fromOffset(0, 0),
					TextTransparency = 1,
					ZIndex = 3,
				}, holder)
				e = { Holder = holder, Label = lab, Token = 0, State = "new" }
				self.KbEntries[t] = e
			end
			e.Label.Text = txt
			if e.State ~= "in" then
				e.Token += 1
				e.State = "in"
				tween(e.Holder, 0.2, { Size = UDim2.fromOffset(0, 16) })
				tween(e.Label, 0.2, { TextTransparency = 0 })
			end
		elseif e and e.State ~= "out" then
			e.State = "out"
			e.Token += 1
			local tok = e.Token
			tween(e.Holder, 0.2, { Size = UDim2.fromOffset(0, 0) })
			tween(e.Label, 0.15, { TextTransparency = 1 })
			task.delay(0.22, function()
				if e.Token == tok then
					e.Holder:Destroy()
					if self.KbEntries[t] == e then
						self.KbEntries[t] = nil
					end
				end
			end)
		end
	end
end

