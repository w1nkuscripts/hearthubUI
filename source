-- Drag 
local function makeDraggable(handle, target)
	connect(handle.InputBegan, function(input)
		if isPress(input) then
			local start = cursor()
			local startPos = resolvePos(target)
			Library.Dragging = {
				Update = function()
					local d = cursor() - start
					local vp = workspace.CurrentCamera.ViewportSize
					target.Position = UDim2.fromOffset(
						math.clamp(startPos.X + d.X, -target.AbsoluteSize.X + 80, vp.X - 80),
						math.clamp(startPos.Y + d.Y, 0, vp.Y - 30)
					)
				end,
			}
		end
	end)
end

-- HUD 
function Library:_BuildHud(gui)
	local accentHex = "#" .. T.Accent:ToHex()

	local wm = frame({
		Name = "Watermark",
		BackgroundColor3 = T.Background,
		BackgroundTransparency = 0.08,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -14, 0, 14),
		AutomaticSize = Enum.AutomaticSize.XY,
		Size = UDim2.fromOffset(0, 0),
		ZIndex = 3,
	}, gui)
	stroke(wm, T.Border)
	local wmText = newText("TextLabel", {
		Text = "",
		RichText = true,
		AutomaticSize = Enum.AutomaticSize.XY,
		Size = UDim2.fromOffset(0, 0),
		ZIndex = 3,
	}, wm)
	padding(wmText, 8, 6, 8, 5)
	shimmerLine({ Size = UDim2.new(1, 0, 0, 1), ZIndex = 4 }, wm)
	self.Watermark = wm

	local kb = frame({
		Name = "KeybindList",
		BackgroundColor3 = T.Background,
		BackgroundTransparency = 0.08,
		Position = UDim2.fromOffset(14, workspace.CurrentCamera.ViewportSize.Y * 0.42),
		AutomaticSize = Enum.AutomaticSize.XY,
		Size = UDim2.fromOffset(0, 0),
		ZIndex = 3,
		Active = true,
	}, gui)
	create("UISizeConstraint", { MinSize = Vector2.new(150, 0) }, kb)
	stroke(kb, T.Border)
	local inner = frame({
		AutomaticSize = Enum.AutomaticSize.XY,
		Size = UDim2.fromOffset(0, 0),
		ZIndex = 3,
	}, kb)
	padding(inner, 8, 7, 8, 7)
	list(inner, 2)
	newText("TextLabel", {
		Text = "keybinds",
		TextColor3 = T.Accent,
		AutomaticSize = Enum.AutomaticSize.XY,
		Size = UDim2.fromOffset(0, 0),
		LayoutOrder = 1,
		ZIndex = 3,
	}, inner)
	shimmerLine({ Size = UDim2.new(1, 0, 0, 1), ZIndex = 4 }, kb)
	makeDraggable(kb, kb)

	self.KeybindFrame = kb
	self.KbInner = inner

	-- watermark 
	local fps, frames, acc, last = 60, 0, 0, 0
	local function getPing()
		local ok, v = pcall(function()
			return Stats.Network.ServerStatsItem["Data Ping"]:GetValue()
		end)
		return ok and math.floor(v) or 0
	end
	local function updateWatermark()
		wmText.Text = string.format(
			'%s<font color="%s">%s</font> | %s [%s] | %s | %s | %d fps | %d ms',
			self.Name, accentHex, self.Suffix, LocalPlayer.Name, self.Mode,
			os.date("%Y-%m-%d"), os.date("%H:%M:%S"), fps, getPing()
		)
	end
	updateWatermark()

	connect(RunService.RenderStepped, function(dt)
		local now = os.clock()

		-- 
		local x = ((now * 0.7) % 2) - 1
		for i = #shimmers, 1, -1 do
			local g = shimmers[i]
			if g.Parent == nil then
				table.remove(shimmers, i)
			else
				g.Offset = Vector2.new(x, 0)
			end
		end

		-- 
		local a = 1 - math.exp(-dt * 16)
		for i = #Lines, 1, -1 do
			local L = Lines[i]
			if L.Frame.Parent == nil then
				table.remove(Lines, i)
			elseif L.Target and L.Target.Parent then
				local tx = L.Target.AbsolutePosition.X - L.Holder.AbsolutePosition.X + L.PadX
				local tw = L.Target.AbsoluteSize.X - L.PadX * 2
				if tw > 0 then
					if not L.Init then
						L.X, L.W, L.Init = tx, tw, true
						L.Frame.Visible = true
					else
						L.X += (tx - L.X) * a
						L.W += (tw - L.W) * a
					end
					L.Frame.Position = UDim2.fromOffset(L.X, L.Scroller.AbsoluteSize.Y - 3)
					L.Frame.Size = UDim2.fromOffset(L.W, 2)
				end
			end
		end

		-- 
		if self.Dragging then
			self.Dragging.Update()
		end
		-- попап следует за якорем
		if self.Popup then
			self.Popup.Place()
		end

		-- fps
		frames += 1
		acc += dt
		if acc >= 0.5 then
			fps = math.floor(frames / acc + 0.5)
			frames, acc = 0, 0
		end
		if now - last >= 0.25 then
			last = now
			updateWatermark()
		end
	end)
end

-- Registry 
function Library:Register(name, sub, rowFrame)
	table.insert(self.Registry, { Name = name, Sub = sub, Tab = sub.Tab, Frame = rowFrame })
end

local function commitFlag(el, value)
	if el.Flag then
		Library.Flags[el.Flag] = value
	end
end

local function flash(f)
	local fl = frame({
		BackgroundColor3 = T.Accent,
		BackgroundTransparency = 0.7,
		Size = UDim2.new(1, 6, 1, 4),
		Position = UDim2.fromOffset(-3, -2),
		ZIndex = 5,
	}, f)
	tween(fl, 0.9, { BackgroundTransparency = 1 })
	task.delay(1, function()
		fl:Destroy()
	end)
end

