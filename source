		for _, t in ipairs(self.Tabs) do
			if t == tab then
				fadeIn(t.Content, 8)
				tween(t.Button, 0.15, { TextColor3 = T.Text })
			else
				fadeOut(t.Content)
				tween(t.Button, 0.15, { TextColor3 = T.TextDim })
