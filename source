		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 2,
		ScrollBarImageColor3 = T.Accent,
		Visible = false,
		ZIndex = 10,
	}, body)
	list(results, 2)
	local resultRows = {}

	local function clearResults()
		for _, r in ipairs(resultRows) do
			r:Destroy()
		end
		table.clear(resultRows)
	end

	local searchOpen = false
	local function closeSearch()
		searchOpen = false
		searchBox.Visible = false
		results.Visible = false
		searchBox.Text = ""
		clearResults()
		paintMag(T.TextDim)
	end

	local function rebuildResults()
		clearResults()
		local q = searchBox.Text:lower()
		local shown = 0
		for _, e in ipairs(Library.Registry) do
			if q ~= "" and e.Name:lower():find(q, 1, true) and e.Tab.Window == Window then
				shown += 1
				local b = newText("TextButton", {
					Text = e.Name,
					Size = UDim2.new(1, -6, 0, 22),
					LayoutOrder = shown,
					ZIndex = 11,
				}, results)
