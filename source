		}, Tab.Content)
		stroke(subBar, T.Border)
		padding(subBar, 4, 0, 4, 0)
		local subHolder = frame({
			Size = UDim2.new(0, 0, 1, 0),
			AutomaticSize = Enum.AutomaticSize.X,
		}, subBar)
		list(subHolder, 4, true)
		bindWheel(subBar, subBar)
		bindWheel(subBar, subHolder)
		Tab.SubBar = subBar
		local subLine = makeLine(subBar, subHolder, 8)

		Tab.Pages = frame({
			Position = UDim2.fromOffset(0, 36),
			Size = UDim2.new(1, 0, 1, -36),
		}, Tab.Content)

		function Tab:SelectSubTab(sub)
			if self.ActiveSub == sub then
				return
			end
			for _, s in ipairs(self.SubTabs) do
				if s == sub then
					fadeIn(s.Group, 8)
					tween(s.Button, 0.15, { TextColor3 = T.Text })
				else
					fadeOut(s.Group)
					tween(s.Button, 0.15, { TextColor3 = T.TextDim })
				end
			end
			self.ActiveSub = sub
			subLine.Target = sub.Button
			Library:ClosePopup()
			reveal(subBar, subHolder, sub.Button)
		end

		function Tab:AddSubTab(subName)
			local Sub = setmetatable({ Name = subName, Tab = Tab, Count = 0 }, SubTab)

			local sbtn = newText("TextButton", {
				Text = subName,
				TextColor3 = T.TextDim,
				Size = UDim2.new(0, 0, 1, 0),
				AutomaticSize = Enum.AutomaticSize.X,
				LayoutOrder = #self.SubTabs + 1,
			}, subHolder)
			padding(sbtn, 8, 0, 8, 0)
			Sub.Button = sbtn
			bindWheel(subBar, sbtn)
			sbtn.MouseEnter:Connect(function()
				if Tab.ActiveSub ~= Sub then
					tween(sbtn, 0.12, { TextColor3 = T.Text })
				end
			end)
			sbtn.MouseLeave:Connect(function()
				if Tab.ActiveSub ~= Sub then
					tween(sbtn, 0.12, { TextColor3 = T.TextDim })
				end
			end)
			sbtn.MouseButton1Click:Connect(function()
				Tab:SelectSubTab(Sub)
			end)

			Sub.Group = create("CanvasGroup", {
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				Size = UDim2.fromScale(1, 1),
				Visible = false,
				GroupTransparency = 1,
			}, Tab.Pages)

			local page = create("ScrollingFrame", {
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				Size = UDim2.fromScale(1, 1),
				CanvasSize = UDim2.new(),
				AutomaticCanvasSize = Enum.AutomaticSize.Y,
				ScrollBarThickness = 3,
				ScrollBarImageColor3 = T.AccentDark,
				ScrollingDirection = Enum.ScrollingDirection.Y,
			}, Sub.Group)
			padding(page, 1, 1, 1, 8)
			Sub.Page = page

			Sub.Left = frame({
				Size = UDim2.new(0.5, -6, 0, 0),
				AutomaticSize = Enum.AutomaticSize.Y,
			}, page)
			list(Sub.Left, 8)
			Sub.Right = frame({
				Position = UDim2.fromScale(0.5, 0),
				Size = UDim2.new(0.5, -6, 0, 0),
				AutomaticSize = Enum.AutomaticSize.Y,
			}, page)
			list(Sub.Right, 8)

			table.insert(self.SubTabs, Sub)
			if #self.SubTabs == 1 then
				self:SelectSubTab(Sub)
			end
			return Sub
		end
		Tab.CreateSubTab = Tab.AddSubTab

		table.insert(self.Tabs, Tab)
		if #self.Tabs == 1 then
			self:SelectTab(Tab)
		end
		return Tab
	end
	Window.CreateTab = Window.AddTab

	table.insert(Library.Windows, Window)

	--
	if not Library._InputReady then
		Library._InputReady = true

		Library:_BuildHud(gui)

		connect(UIS.InputBegan, function(input, gpe)
			-- 
			if Library.Listening then
				local t = input.UserInputType
				if t == Enum.UserInputType.Keyboard or t == Enum.UserInputType.MouseButton1
					or t == Enum.UserInputType.MouseButton2 or t == Enum.UserInputType.MouseButton3
					or t == Enum.UserInputType.Touch then
					Library.Listening(input)
				end
				return
			end

			if UIS:GetFocusedTextBox() then
				return
			end

			-- 
			if input.KeyCode == Library.ToggleKey then
				for _, w in ipairs(Library.Windows) do
					w:SetOpen(not w.Open)
				end
				return
			end

			-- 
			if input.UserInputType ~= Enum.UserInputType.Keyboard and gpe then
				return
			end
			for _, tg in ipairs(Library.Binds) do
				local k = tg.Key
				if k and (input.KeyCode == k or input.UserInputType == k) then
					if tg.Mode == "hold" then
						tg.KeyDown = true
						tg:Set(true)
					elseif tg.Mode == "toggle" then
						tg:Set(not tg.Value)
					end
				end
			end
		end)

		connect(UIS.InputEnded, function(input)
			if isPress(input) then
				Library.Dragging = nil
			end
			for _, tg in ipairs(Library.Binds) do
				local k = tg.Key
				if k and tg.Mode == "hold" and (input.KeyCode == k or input.UserInputType == k) then
					tg.KeyDown = false
					tg:Set(false)
				end
			end
		end)
	end

	return Window
end
Library.CreateWindow = Library.New

function Library:Unload()
	for _, c in ipairs(self.Connections) do
		c:Disconnect()
	end
	table.clear(self.Connections)
	table.clear(self.Binds)
	table.clear(self.Registry)
	table.clear(self.Windows)
	table.clear(self.KbEntries)
	table.clear(self.Flags)
	table.clear(self.Options)
	table.clear(Lines)
	table.clear(shimmers)
	self.Dragging, self.Popup, self.Listening = nil, nil, nil
	self._InputReady = false
	self.KbInner, self.KeybindFrame, self.Watermark = nil, nil, nil
	if self.Gui then
		self.Gui:Destroy()
		self.Gui = nil
	end
end

return Library
